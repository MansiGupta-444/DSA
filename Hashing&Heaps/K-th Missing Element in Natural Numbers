class Solution {
    public int findKthSmall(int[] arr, int k) {
        // code here
        HashMap<Integer,Integer> hm = new HashMap<>();
        int j;
        for(int i =0;i<arr.length;i++){
            hm.put(arr[i],arr[i]);
        }
        for(j=1;j<=k;j++){
            if(hm.containsKey(j)){
                k=k+1;
              }
            }
        
        return k;
    }
}
