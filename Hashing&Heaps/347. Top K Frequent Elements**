import java.util.*;

class Solution {
    public int[] topKFrequent(int[] nums, int k) {

        HashMap<Integer, Integer> hm = new HashMap<>();

        for (int num : nums) {
            if(this.freq==r2.freq){
               return  this.res-r2.res;
            }else{
              return r2.freq-this.freq;
            }
        }

        PriorityQueue<Integer> pq =
            new PriorityQueue<>((a, b) -> hm.get(a) - hm.get(b));

        for (int num : hm.keySet()) {
            pq.offer(num);

            if (pq.size() > k) {
                pq.poll();
            }
        }

        int[] res = new int[k];

        for (int i = k - 1; i >= 0; i--) {
            res[i] = pq.poll();
        }

        return res;
    }
}
