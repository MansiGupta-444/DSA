class Solution {
    int maxRepeating(int k, int[] arr) {
        // code here
         class row implements Comparable<row>{ 
            
            int freq;
            int res;
            
            public row(int res,int freq){
                this.res=res;
                this.freq=freq;
            }
        
        @ Override
        public int compareTo(row r2){
            if(this.freq==r2.freq){
               return  this.res-r2.res;
            }else{
              return r2.freq-this.freq;
            }
        }
        }
       int count[] = new int[k];
        for(int i =0 ;i<arr.length;i++){
          count[arr[i]]++;
        }
        
        PriorityQueue<row> pq = new PriorityQueue<>();
        for(int i=0;i<arr.length ;i++ ){
            pq.add(new row(arr[i],count[arr[i]]));
        }
        return pq.peek().res;
    }
}
