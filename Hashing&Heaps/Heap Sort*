class Solution {
    // Function to sort an array using Heap Sort.
    public void heapify(int arr[],int i,int size){
        int left = 2*i+1;
        int right =2*i+2;
        int maxIdx =i;
        if(left<size && arr[maxIdx]<arr[left]){
            maxIdx=left;
        }
        if(right<size && arr[maxIdx]<arr[right]){
            maxIdx=right;
        }
        if(maxIdx!=i){
            int temp = arr[i];
            arr[i] = arr[maxIdx];
            arr[maxIdx] =temp;
            
            heapify(arr,maxIdx,size);
        }
        
    }
    public void heapSort(int arr[]) {
        // code here
        int n = arr.length;
        for(int i =n/2 ;i>=0;i--){
            heapify(arr,i,n);
        }
            for(int j =n-1;j>0;j--){
                int temp = arr[0];
                arr[0]=arr[j];
                  arr[j]=temp;
                  heapify(arr,0,j);
            }
        }
        
    }
