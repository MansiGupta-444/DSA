
class Solution {
    public boolean isSameTree(TreeNode p, TreeNode q) {
         if (p == null && q == null) {
            return true;
        }

        // One tree is empty, the other is not
        if (p == null || q == null) {
            return false;
        }

        // Data at current nodes must match
        if (p.val != q.val) {
            return false;
        }

        // Case 1: No swap
        boolean check =
                isSameTree(p.left, q.left) &&
                isSameTree(p.right, q.right);

    

        return check ;
    }
}
