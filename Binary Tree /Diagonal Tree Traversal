//first solution
class Tree {
    public ArrayList<Integer> diagonal(Node root) {
        ArrayList<Integer> ans = new ArrayList<>();
        if(root==null){
            return ans;
        }
        Queue<Node> q = new LinkedList<>();
        q.add(root);
        while(!q.isEmpty()){
            Node curr = q.remove();
            while(curr!=null){
                ans.add(curr.data);
                if(curr.left!=null){
                    q.add(curr.left);
                }
                curr=curr.right;
            }
        }
        return ans;
        
    }
}
