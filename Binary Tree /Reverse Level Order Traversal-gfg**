class Solution {
    public List<Integer> reverseLevelOrder(Node root) {
        // code here
        ArrayList<Integer> arr = new ArrayList<>();
            Queue<Node> q = new LinkedList<>();
            Stack<Integer> s = new Stack<>();
            q.add(root);
            while(!q.isEmpty()){
                Node curr = q.remove();
                s.push(curr.data);
                if(curr.right!=null){
                    q.add(curr.right);
                }
                if(curr.left!=null){
                    q.add(curr.left);
                }
                
            }
            
            while(!s.isEmpty()){
                arr.add(s.pop());
            }
            
            return arr;
    }
}
