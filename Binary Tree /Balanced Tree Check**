
class Solution {
     int height(Node root){
        if(root == null)
            return 0;

        int lh = height(root.left);
        int rh = height(root.right);

        return Math.max(lh, rh) + 1;
    }
    public boolean isBalanced(Node root) {
        // code here
         if(root==null){
             return true;
         }
         int lh = height(root.left);
         int rh = height(root.right);
         
         if(Math.abs(lh-rh)>1){
             return false;
         }
         boolean l = isBalanced(root.left);
         boolean r = isBalanced(root.right);
         
         if(l==true && r== true){
             return true;
         }
         else{
            return false;
         }
         
    }
}


