
lass Solution {
    int pre = 0;
    public  TreeNode binTree(int[] preorder, int[] inorder,int start,int end){

        if(start>end){
           return null;
        }

     TreeNode root = new TreeNode(preorder[pre++]);

       int index=start;
        for(int i = start;i<=end;i++){
           if(inorder[i]==root.val){
             index=i;
             break;
           }
        }
        root.left = binTree(preorder,inorder,start,index-1);
        root.right = binTree(preorder,inorder,index+1,end);

        return root;
    }

    public TreeNode buildTree(int[] preorder, int[] inorder) {
        
       return binTree(preorder,inorder,0,preorder.length-1);
        
    }
}
