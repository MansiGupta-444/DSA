class Solution {
    public int countWays(int n) {
        // code here
        int coins[]={3,5,10};
        
        int dp[]=new int[n+1];
        dp[0]=1;
        for(int j =0;j<coins.length;j++){
            for(int i =coins[j];i<=n;i++){
                dp[i] = dp[i] +dp[i-coins[j]];
            }
        }
        
        return dp[n];
        
    }
}
