class Solution {
    public ArrayList<String> helper(int[][] maze,int sr,int sc,String res,boolean vis[][],
    ArrayList<String> path){
        
        int n =maze.length-1;
       if(sr<0||sc<0||sr>=maze.length||sc>=maze[0].length || maze[sr][sc]==0||vis[sr][sc]){
           return path;
       }
        if(sr==n &&sc==n){
            path.add(res);
            return path;
        }
        vis[sr][sc]=true;
      
       helper(maze,sr+1,sc,res+"D",vis,path);
       helper(maze,sr,sc-1,res+"L",vis,path);
       helper(maze,sr,sc+1,res+"R",vis,path);
       helper(maze,sr-1,sc,res+"U",vis,path);
       vis[sr][sc] = false;   // Backtracking
       return path;
    }
    
    public ArrayList<String> ratInMaze(int[][] maze) {
         int n =maze.length;
        ArrayList<String> path = new ArrayList<>();
        if (maze[0][0] == 0 || maze[n - 1][n - 1] == 0)
            return path;
        boolean vis[][] = new boolean[n][n];
        return helper(maze,0,0,"",vis,path);
        
    }
}



