//  second solution :logic

class Solution {
    public int[] productExceptSelf(int[] nums) {
        
        int res[] = new int[nums.length];
       res[0]=1;
// calculate all left
        for(int i =1;i<nums.length;i++){
            res[i] = res[i-1]*nums[i-1];
        }
  // calculate all right 
         int suf =1;
        for(int i =nums.length-1;i>=0;i--){
            res[i] = suf*res[i];  
            suf*=nums[i]; 
        }
        return res;
    }
}  


// first solution
class Solution {
    public int[] productExceptSelf(int[] nums) {

        int prod = 1;
        int count = 0;
        int[] res = new int[nums.length];

        for(int num : nums) {
            if(num == 0) {
                count++;
            } else {
                prod *= num;
            }
        }

        if(count > 1) {
            return res; // all zeros
        }

        for(int i = 0; i < nums.length; i++) {
            if(count == 1) {
                if(nums[i] == 0) {
                    res[i] = prod;
                } else {
                    res[i] = 0;
                }
            } else {
                res[i] = prod / nums[i];
            }
        }

        return res;
    }
}























