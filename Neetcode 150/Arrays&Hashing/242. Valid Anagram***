import java.util.*;
class Solution {
    public static boolean isAnagram(String s, String t) {
        
        if(s.length()!=t.length()){
            return false;
        }
        // toCharArray() converts string to character array[i,d,f,s,]
        char a[] = s.toCharArray();
        char b[] = t.toCharArray();
        // it sort array
        Arrays.sort(a);
        Arrays.sort(b);
        //it checks if array a equals array b
        return Arrays.equals(a,b);
         
    }
