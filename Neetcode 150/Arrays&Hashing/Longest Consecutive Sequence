class Solution {
    public int longestConsecutive(int[] nums) {

        if(nums.length==0){
            return 0;
        }
        Arrays.sort(nums);
        int count=0;
        int len = 0;
        for(int i =1 ;i<nums.length;i++){
            if(nums[i-1]+1==nums[i]){
              count=count+1;
              len = Math.max(len,count);
            }else if(nums[i-1]==nums[i]){
            continue;
            }
            else{
             count=0;
            }
            
        }
        return len+1;
    }
}
