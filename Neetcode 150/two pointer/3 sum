class Solution {
    public List<List<Integer>> threeSum(int[] nums) {

      Arrays.sort(nums);
      int n = nums.length;
       int left = 0;
       int right = n;

       List<List<Integer>> ans = new ArrayList<>();
       
       for(int i =0;i<n;i++){

        left=i+1;
        right= n-1;
          while(left<right){
           int sum = nums[i]+nums[left]+nums[right];
           if(sum==0){
            List<Integer> res = new ArrayList<>();
            res.add(nums[i]);
            res.add(nums[left]);
            res.add(nums[right]);
           if(!ans.contains(res)){
            ans.add(res);  }
             left++;
             right--;    
             }
            else if(sum<0){
                left++;
             }
             else{
            right--;
             }

          }
        
       }
      return ans;
    }
}
