     Queue<Integer> q1 = new LinkedList<>();
     Queue<Integer> q2 = new LinkedList<>();

    public MyStack() {}

    public void push(int x) {
        if (!q1.isEmpty()) {
            q1.add(x);
        } else {
            q2.add(x);
        }
    }

    public int pop() {
        if (empty()) {
            return -1;
        }

        int top = -1;

        if (!q1.isEmpty()) {
            while (!q1.isEmpty()) {     // your logic kept
                top = q1.remove();
                if (q1.isEmpty()) {
                    break;
                } else {
                    q2.add(top);
                }
            }
        } else {
            while (!q2.isEmpty()) {     // your logic kept
                top = q2.remove();
                if (q2.isEmpty()) {
                    break;
                } else {
                    q1.add(top);
                }
            }
        }

        return top;
    }

    public int top() {
        if (empty()) {
            return -1;
        }

        int top = -1;

        if (!q1.isEmpty()) {
            while (!q1.isEmpty()) {     // your logic kept
                top = q1.remove();
                q2.add(top);
            }
        } else {
            while (!q2.isEmpty()) {     // your logic kept
                top = q2.remove();
                q1.add(top);
            }
        }

        return top;
    }

    public boolean empty() {
        return q1.isEmpty() && q2.isEmpty();
    }
