import java.util.*;

class Solution {
    static boolean findDuplicateparenthesis(String s) {
        Stack<Character> st = new Stack<>();

        for (char ch : s.toCharArray()) {

            if (ch == ')') {

                if (st.peek() == '(') {
                    return true;
                }

                while (st.peek() != '(') {
                    st.pop();
                }

                st.pop(); // remove '('
            }
            else {
                st.push(ch);
            }
        }

        return false;
    }
}

