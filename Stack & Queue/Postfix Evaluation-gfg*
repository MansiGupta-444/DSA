class Solution {
    public int evaluatePostfix(String[] arr) {

        Stack<Integer> s = new Stack<>();

        int a, b, res;

        for (int i = 0; i < arr.length; i++) {

            if (arr[i].equals("+")) {
                a = s.pop();
                b = s.pop();
                res = b + a;
                s.push(res);
            }

            else if (arr[i].equals("-")) {
                a = s.pop();
                b = s.pop();
                res = b - a;
                s.push(res);
            }

            else if (arr[i].equals("/")) {
                a = s.pop();
                b = s.pop();
                res = (int)Math.floor((double)b / a);
                s.push(res);
            }

            else if (arr[i].equals("*")) {
                a = s.pop();
                b = s.pop();
                res = b * a;
                s.push(res);
            }

            else if (arr[i].equals("^")) {
                a = s.pop();
                b = s.pop();
                res = (int) Math.pow(b, a);
                s.push(res);
            }

            else {
                s.push(Integer.parseInt(arr[i]));
            }
        }

        return s.pop();
    }
}
